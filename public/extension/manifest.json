{
  "manifest_version": 3,
  "name": "Precedents",
  "version": "1.1.0",
  "description": "Search Greenshoot's Precedents library and download images; send pages, images and screenshots to its inbox.",
  "action": {
    "default_title": "Precedents: search and send",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "__SITE__/*"
  ]
}
